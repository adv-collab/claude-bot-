# Credenciais da Z-API (painel: https://app.z-api.io)
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN_SE_HOUVER

# Número do WhatsApp do Guilherme para receber notificação de novos leads
# Formato: 55 + DDD + numero (ex: 5542999999999)
ADVOGADO_WHATSAPP=5542999999999

# Porta do servidor
PORT=3000

# Valor de corte (em R$) para classificar lead como IMPORTANTE
VALOR_CORTE_IMPORTANTE=1000000

# --- Google Sheets (armazenamento dos leads) ---
# ID da planilha: fica na URL, entre /d/ e /edit
# Ex: https://docs.google.com/spreadsheets/d/AQUI_O_ID/edit
GOOGLE_SHEET_ID=
# E-mail da Service Account (Google Cloud) — compartilhe a planilha com esse e-mail
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da Service Account (do arquivo JSON baixado do Google Cloud)
# Cole entre aspas e mantenha os "\n" literais
GOOGLE_PRIVATE_KEY=""
# Nome da aba onde os leads serão gravados (criada automaticamente se não existir)
GOOGLE_SHEET_ABA=Leads
